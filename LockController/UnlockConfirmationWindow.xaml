<Window x:Class="LockController.UnlockConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm early unlock" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="90" Padding="12,8" Margin="0,0,12,0"/>
            <Button Content="Unlock" Click="Confirm_Click" MinWidth="90" Padding="12,8"/>
        </StackPanel>
    </StackPanel>
</Window>
